{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/tracker",
      "destination": "/tracker.html"
    },
    {
      "source": "/tracker/",
      "destination": "/tracker.html"
    }
  ],
  "redirects": [
    {
      "source": "/policy-impact-explorer.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/policy-impact-explorer",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/go/omnicosmos",
      "destination": "https://cosmos.techandtonic.tech/",
      "permanent": false
    },
    {
      "source": "/go/library",
      "destination": "https://techandtonic.github.io/indigenous-pages/",
      "permanent": false
    },
    {
      "source": "/go/modoc",
      "destination": "https://techandtonic.github.io/Modoc-War/",
      "permanent": false
    },
    {
      "source": "/go/watershed",
      "destination": "https://techandtonic.github.io/klamath-watershed/",
      "permanent": false
    },
    {
      "source": "/go/language",
      "destination": "https://techandtonic.github.io/klamath-app-medicine-wheel/",
      "permanent": false
    },
    {
      "source": "/go/oracle",
      "destination": "https://techandtonic.github.io/OracleNeumero/",
      "permanent": false
    }
  ]
}
